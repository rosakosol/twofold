{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Newsreader))/i]",
        "message": "Font not provided by the design system. Available: Inter, Newsreader."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--bg-bottom",
      "--bg-top",
      "--border-soft",
      "--border-softer",
      "--button-bottom",
      "--button-top",
      "--card-bg",
      "--card-bg-alt",
      "--faint-ink",
      "--font-body",
      "--font-display",
      "--heart-red",
      "--heart-red-deep",
      "--ink",
      "--leaf-green",
      "--leaf-green-deep",
      "--radius-card",
      "--radius-lg",
      "--radius-pill",
      "--radius-sm",
      "--shadow-lg",
      "--shadow-md",
      "--shadow-sm",
      "--sky-blue",
      "--sky-blue-deep",
      "--sky-blue-light",
      "--subtle-ink"
    ],
    "tokenKinds": {
      "--sky-blue": "color",
      "--sky-blue-light": "color",
      "--sky-blue-deep": "color",
      "--leaf-green": "color",
      "--leaf-green-deep": "color",
      "--heart-red": "color",
      "--heart-red-deep": "color",
      "--ink": "color",
      "--subtle-ink": "color",
      "--faint-ink": "color",
      "--bg-top": "color",
      "--bg-bottom": "color",
      "--card-bg": "color",
      "--card-bg-alt": "color",
      "--border-soft": "color",
      "--border-softer": "color",
      "--button-top": "color",
      "--button-bottom": "color",
      "--shadow-sm": "shadow",
      "--shadow-md": "shadow",
      "--shadow-lg": "shadow",
      "--radius-sm": "radius",
      "--radius-card": "radius",
      "--radius-lg": "radius",
      "--radius-pill": "radius",
      "--font-display": "font",
      "--font-body": "font"
    },
    "fontFamilies": [
      "Inter",
      "Newsreader"
    ]
  }
}